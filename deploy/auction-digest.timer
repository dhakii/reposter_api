[Unit]
Description=Trigger Auction Video Digest Daily at 18:00 (Cascade 1 Video / 3 Platforms)
Requires=auction-digest.service

[Timer]
# Запуск каждый день строго в 18:00 (вечерний прайм-тайм):
#   День 1 (18:00) -> Создание ролика и публикация в VK Клипы
#   День 2 (18:00) -> Этот же ролик в Instagram Reels
#   День 3 (18:00) -> Этот же ролик в YouTube Shorts
#   День 4 (18:00) -> Новый ролик в VK Клипы (новый цикл)
OnCalendar=*-*-* 18:00:00

# Persistent=true: если сервер был временно выключен в 18:00,
# задача выполнится сразу после включения сервера
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
