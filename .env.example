# ==============================================================================
# Переменные окружения Reposter & Video Digest Engine
# ==============================================================================

# Токен безопасности для API запросов
API_BEARER_TOKEN=your_secure_bearer_token

# ВКонтакте (Клипы и Стена)
VK_USER_TOKEN=vk1.a.your_user_token_with_wall_video_scope
VK_GROUP_ID=123456789
# Опциональный Cloudflare Proxy Worker при сетевых блокировках хостинга:
VK_PROXY_URL=https://vk-proxy.your-subdomain.workers.dev
VK_PROXY_SECRET=your_optional_secret

# Telegram канал для парсинга свежих картин
TELEGRAM_CHANNEL_URL=https://t.me/s/marinakhakimova_auction
TELEGRAM_CHANNEL_HANDLE=@marinakhakimova_auction

# Опционально: путь к базе данных SQLite аукционного бота (если на одном VPS)
AUCTION_DB_PATH=/root/auction-bot/auction_bot.db

# Настройки публикации на другие платформы (модули готовы к подключению):
# YouTube Shorts (через YouTube Data API v3):
# YOUTUBE_CLIENT_SECRETS_FILE=./client_secret.json
# YOUTUBE_REFRESH_TOKEN=...

# Instagram Reels (через Meta Graph API):
# INSTAGRAM_ACCESS_TOKEN=...
# INSTAGRAM_ACCOUNT_ID=...
# PUBLIC_APP_URL=https://your-domain.com

# TikTok (через TikTok Content Posting API):
# TIKTOK_ACCESS_TOKEN=...
