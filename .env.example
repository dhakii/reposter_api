# ==============================================================================
# КОНФИГУРАЦИЯ REPOSTER & VIDEO DIGEST ENGINE
# ==============================================================================

# Токен безопасности для API запросов FastAPI
API_BEARER_TOKEN=your_secure_bearer_token

# Публичный адрес вашего сервера (нужен для Meta/Instagram, чтобы скачать ролик)
# Например: http://123.45.67.89:8000 или https://reposter.your-domain.ru
PUBLIC_APP_URL=http://your_vps_ip:8000

# Telegram-канал аукциона
TELEGRAM_CHANNEL_URL=https://t.me/marinakhakimova_auction
TELEGRAM_CHANNEL_HANDLE=@marinakhakimova_auction

# Путь к SQLite базе данных бота аукциона (для умного добора старых картин)
AUCTION_DB_PATH=/root/auction-bot/auction_bot.db

# Порядок каскадной публикации (1 ролик на 3 дня):
# День 1 -> vk, День 2 -> instagram, День 3 -> youtube
CASCADE_PLATFORMS=vk,instagram,youtube


# ==============================================================================
# 1. ВКОНТАКТЕ (VK Клипы и Стена группы)
# ==============================================================================
# Токен пользователя VK с правами: wall,video,offline
VK_USER_TOKEN=vk1.a.your_user_token_here
# ID группы VK без минуса (например: 123456789)
VK_GROUP_ID=123456789
# Опционально: Cloudflare Proxy Worker при сетевых блокировках хостинга
VK_PROXY_URL=
VK_PROXY_SECRET=


# ==============================================================================
# 2. YOUTUBE SHORTS (Google YouTube Data API v3)
# ==============================================================================
# Получаются в 1 клик через скрипт: python scripts/setup_youtube_auth.py
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_client_secret
YOUTUBE_REFRESH_TOKEN=1//04your_refresh_token_here
YOUTUBE_PRIVACY_STATUS=public


# ==============================================================================
# 3. INSTAGRAM REELS (Meta Graph API)
# ==============================================================================
# Long-Lived Token пользователя/страницы с правами instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=EAAB...your_long_lived_meta_token_here
# Числовой ID связанного бизнес-аккаунта Instagram (Instagram Account ID)
INSTAGRAM_ACCOUNT_ID=17841400000000000


# ==============================================================================
# 4. TIKTOK (Опционально: TikTok Content Posting API)
# ==============================================================================
TIKTOK_ACCESS_TOKEN=
